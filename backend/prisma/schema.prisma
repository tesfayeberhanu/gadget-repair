datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TECHNICIAN
  FRONT_DESK
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  WAITING_FOR_PARTS
  COMPLETED
  DELIVERED
  PICKED_UP
}

enum PaymentMethod {
  CASH
  CARD
  DIGITAL_TRANSFER
}

enum PaymentStatus {
  PAID
  PENDING
  UNPAID
  PARTIALLY_PAID
  REFUNDED
}

enum SaleStatus {
  DRAFT
  FINALIZED
  CANCELLED
  REFUNDED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        Role     @default(FRONT_DESK)
  active      Boolean  @default(true)
  permissions String[] @default([])
  salary      Decimal  @default(0) @db.Decimal(10, 2)
  rent        Decimal  @default(0) @db.Decimal(10, 2)
  commission  Decimal  @default(0) @db.Decimal(10, 2)
  allowance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  createdTickets  RepairTicket[]       @relation("CreatedBy")
  assignedTickets RepairTicket[]       @relation("AssignedTech")
  sales           Sale[]
  payments        Payment[]
  auditLogs       AuditLog[]
  deliveries      DeliveryRecord[]
  passwordResets  PasswordResetToken[]
  expenses        Expense[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RepairTicket {
  id                String       @id @default(uuid())
  ticketNumber      String       @unique
  customerName      String
  customerPhone     String
  deviceModel       String
  serialOrImei      String?
  physicalCondition String?
  reportedIssue     String
  technicianNotes   String?
  progress          Int          @default(0)
  status            TicketStatus @default(PENDING)
  estimatedCost     Decimal      @db.Decimal(10, 2)
  serviceCharge     Decimal      @default(0) @db.Decimal(10, 2)
  finalPrice        Decimal?     @db.Decimal(10, 2)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  assignedTechId String?
  assignedTech   User?   @relation("AssignedTech", fields: [assignedTechId], references: [id])

  usedParts          TicketPart[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  delivery           DeliveryRecord?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([customerPhone])
  @@index([serialOrImei])
}

model Customer {
  id               String         @id @default(uuid())
  name             String
  phone            String         @unique
  isCreditCustomer Boolean        @default(false) @map("is_credit_customer")
  repairs          RepairTicket[]
  sales            Sale[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([name])
}

model Part {
  id                 String              @id @default(uuid())
  sku                String              @unique
  name               String
  category           String?
  description        String?
  compatibleDevices  String?
  stockQty           Int
  minimumStockQty    Int                 @default(5)
  costPrice          Decimal             @db.Decimal(10, 2)
  retailPrice        Decimal             @db.Decimal(10, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ticketParts        TicketPart[]
  inventoryMovements InventoryMovement[]
}

model InventoryMovement {
  id        String        @id @default(uuid())
  partId    String?
  part      Part?         @relation(fields: [partId], references: [id], onDelete: SetNull)
  ticketId  String?
  ticket    RepairTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  category  String
  direction String
  quantity  Int
  unitPrice Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  @@index([partId, direction])
  @@index([ticketId])
  @@index([createdAt])
}

model TicketPart {
  id        String       @id @default(uuid())
  ticketId  String
  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  partId    String
  part      Part         @relation(fields: [partId], references: [id])
  quantity  Int          @default(1)
  unitPrice Decimal      @default(0) @db.Decimal(10, 2)

  @@unique([ticketId, partId])
}

model Sale {
  id                  String         @id @default(uuid())
  ticketId            String?
  ticket              RepairTicket?  @relation(fields: [ticketId], references: [id])
  finalizationKey     String?        @unique
  customerId          String?
  customer            Customer?      @relation(fields: [customerId], references: [id])
  totalAmount         Decimal        @db.Decimal(10, 2)
  paymentMethod       PaymentMethod?
  paymentStatus       PaymentStatus  @default(UNPAID)
  status              SaleStatus     @default(DRAFT)
  isCreditSale        Boolean        @default(false)
  recognizedRevenue   Decimal?       @db.Decimal(10, 2)
  finalizedAt         DateTime?
  revenueRecognizedAt DateTime?
  revenueReversedAt   DateTime?
  processedBy         String
  user                User           @relation(fields: [processedBy], references: [id])
  payments            Payment[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([customerId])
  @@index([ticketId])
  @@index([status, revenueRecognizedAt])
}

model Payment {
  id             String        @id @default(uuid())
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  idempotencyKey String        @unique
  processedBy    String
  user           User          @relation(fields: [processedBy], references: [id])
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime      @default(now())

  @@index([saleId, createdAt])
}

model Expense {
  id           String   @id @default(uuid())
  description  String
  category     String
  amount       Decimal  @db.Decimal(10, 2)
  expenseDate  DateTime @db.Date
  notes        String?
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([timestamp])
}

model Appointment {
  id            String            @id @default(uuid())
  customerName  String
  customerPhone String
  device        String
  issue         String
  preferredDate DateTime
  status        AppointmentStatus @default(REQUESTED)
  createdAt     DateTime          @default(now())

  @@index([preferredDate])
  @@index([customerPhone])
}

model PromoBanner {
  id        String   @id @default(uuid())
  title     String?
  subtitle  String?
  linkUrl   String?
  imageData Bytes
  imageType String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model StaffProfile {
  id        String   @id @default(uuid())
  name      String
  role      String
  bio       String?
  photoData Bytes?
  photoType String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model BlogPost {
  id        String   @id @default(uuid())
  tag       String
  title     String
  summary   String
  body      String
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model DeliveryRecord {
  id            String        @id @default(uuid())
  ticketId      String        @unique
  ticket        RepairTicket  @relation(fields: [ticketId], references: [id])
  deliveredById String
  deliveredBy   User          @relation(fields: [deliveredById], references: [id])
  paymentStatus PaymentStatus
  deliveredAt   DateTime      @default(now())

  @@index([deliveredAt])
  @@index([deliveredById])
}
